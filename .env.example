# ===========================================================================
# AirPulse Global Telemetry Pipeline Configuration
# Copy this file to .env and insert your personal OpenAQ v3 API credentials.
# ===========================================================================

# OpenAQ API Key (Register free at https://explore.openaq.org/)
OPENAQ_API_KEY=your_openaq_api_key_here

# OpenAQ Base URL (v3 default)
OPENAQ_BASE_URL=https://api.openaq.org/v3

# Target Countries for extraction (comma-separated ISO alpha-2 codes)
TARGET_COUNTRIES=US,IN,GB,FR,DE,JP,BR,MX,AE,ZA,CN,CL

# Warehouse Storage Path (defaults to warehouse/warehouse.duckdb)
DUCKDB_PATH=warehouse/warehouse.duckdb

# Server port (default 8000)
PORT=8000
